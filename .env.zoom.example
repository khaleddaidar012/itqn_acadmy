# General OAuth app, user-managed: every teacher authorizes their own Zoom account.
# Copy values into .env.local; never commit real credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://YOUR-DOMAIN/api/zoom/callback
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Retain this key securely. Changing it makes stored authorizations unreadable.
ZOOM_TOKEN_ENCRYPTION_KEY=
ZOOM_WEBHOOK_SECRET=
# Requires meeting:update:status and the production scheduled worker.
ZOOM_AUTO_END=1
